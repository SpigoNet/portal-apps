# Modelo do .env do ambiente de DEV (copiado para o servidor na 1ª execução do deploy-dev.sh).
# Banco vem do docker-compose.dev.yml; cache/sessão/fila no banco (sem Redis).
APP_NAME="Portal Apps (dev)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://192.168.15.10:8084
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Nada de e-mail real no dev: só grava no log
MAIL_MAILER=log
